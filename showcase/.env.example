# 复制为 .env 后修改。路径可以是相对路径（相对本目录）或绝对路径。
# Windows 示例：VIDEOS=C:/Users/me/Videos/Japan    WORK=C:/Users/me/vidcut/work_japan
# macOS 示例：  VIDEOS=/Users/me/Movies/Japan       WORK=./work_japan
VIDEOS=./samples
WORK=./work_docker
PORT=8766
# 可选：用 Claude 做摘要和翻译
ANTHROPIC_API_KEY=
# 语音识别模型：small（默认，快）/ medium / large-v3-turbo（最准，较慢）
VIDCUT_WHISPER_MODEL=small
